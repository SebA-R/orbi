{
  "manifest_version": 3,
  "name": "Clearcart",
  "version": "0.1.0",
  "description": "Voice shopping for screen reader users: lets the Clearcart agent shop on any store, with sensitive sites blocked, with hold-to-talk and subtitles.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clearcart",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "tabs",
    "tabGroups",
    "debugger",
    "scripting",
    "offscreen",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "options_page": "options/options.html",
  "commands": {
    "toggle-listening": {
      "suggested_key": {
        "default": "Ctrl+Shift+Space",
        "mac": "MacCtrl+Shift+Space"
      },
      "description": "Start or stop listening (toggle, for when holding a key is hard)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/hotkey.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/subtitles.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/context.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
