{
  "manifest_version": 3,
  "name": "Clearcart",
  "version": "0.1.0",
  "description": "Voice shopping for screen reader users: lets the Clearcart agent shop on allowlisted stores, with hold-to-talk and subtitles.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Clearcart",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background/worker.js",
    "type": "module"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://localhost/*"]
}
