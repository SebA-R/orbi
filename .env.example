ANTHROPIC_API_KEY=
CARTESIA_API_KEY=
VISA_ACCEPTANCE_MERCHANT_ID=
VISA_ACCEPTANCE_KEY_ID=
VISA_ACCEPTANCE_SECRET=
# Set to false for tests and recordings that don't need audio (no Cartesia calls).
CLEARCART_VOICE=true
# Local model on Ollama: how long it stays loaded after a request (default 30m).
# Sent with every request, so it overrides Ollama's own OLLAMA_KEEP_ALIVE;
# "default" sends none and leaves Ollama's setting in charge.
# CLEARCART_LOCAL_KEEP_ALIVE=30m
